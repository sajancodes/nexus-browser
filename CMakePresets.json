{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (Ninja, MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CEF_ROOT": "${sourceDir}/third_party/cef/binary",
        "NEXUS_OUTPUT_DIR": "${sourceDir}/build/windows-x64-release/bin"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (Ninja, MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug",
        "CEF_ROOT": "${sourceDir}/third_party/cef/binary",
        "NEXUS_OUTPUT_DIR": "${sourceDir}/build/windows-x64-debug/bin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "jobs": 8
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "jobs": 8
    }
  ]
}
